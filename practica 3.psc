Algoritmo practica_3
	//realice u programa que permita usar dos numeros para realizar las cuatro operaciones al mismo tiempo
	
	//definir variables
	Definir n1 Como Entero
	Definir n2 Como Entero
	Definir suma, resta, multiplicar, dividir Como Entero
	//entrada 
	Escribir "INGRESE EL PRIMER NUMERO "
	Leer n1
	Escribir "INGRESE EL SEGUNDO NUMERO"
	Leer n2
	//Proceso
	suma=n1+n2
	resta=n1-n2
	multiplicar=n1*n2
	dividir=n1/n2
	
	//Salida
	Escribir " EL RESULTADO DE LA SUMA ES: " suma
	Escribir " EL RESULTADO DE LA RESTA ES: " resta
	Escribir " EL RESULTADO DE LA MULTIPLICACION ES: " multiplicar
	Escribir " EL RESULTADO DE LA DIVISION ES: " dividir
	
	
FinAlgoritmo
